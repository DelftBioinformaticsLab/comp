# Site settings for the slurm wrappers. Copy to slurm/site.env (git-ignored) and fill in your cluster's values.
#
# Load it in the shell you submit from (e.g. in ~/.bashrc):   . /path/to/comp/slurm/site.env
# The submit_* scripts and every job load it themselves through slurm/_site.sh. sbatch takes the SBATCH_* variables
# below as the account, partition and QoS of every job (the wrappers carry no site-specific #SBATCH lines).

# --- scheduler ---------------------------------------------------------------------------------------------------
export SBATCH_ACCOUNT=your-account
export SBATCH_PARTITION=your-partition
export SBATCH_QOS=normal

# --- storage -----------------------------------------------------------------------------------------------------
# preprocessed data per cohort: <PREPROCESSING_DIR>/{cris,jiang}/ with the BAMs, fragment files and wigs written by
# the preprocessing (FinaleDB download, fragment-to-BAM conversion, GC correction; see the README)
export PREPROCESSING_DIR=/path/to/preprocessing
# GC-correction software (GCfix) and its hg38 reference files (<GCFIX_DIR>/hg38/)
export GCFIX_DIR=/path/to/GCfix_Software
# ichorCNA 0.3.2 checkout (scripts and wig files) for the panel of normals
export ICHORCNA_DIR=/path/to/ichorCNA

# --- container ---------------------------------------------------------------------------------------------------
# Apptainer image built from container_pixi.def (path relative to the repository root, or absolute)
export CONTAINER=comp.sif
# Apptainer cache and temporary files (keep them out of a small home directory)
export APPTAINER_CACHEDIR=/tmp/${USER}/apptainer_cache
export APPTAINER_TMPDIR=/tmp/${USER}/apptainer_tmp
