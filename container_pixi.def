# Version: 0.1.2
# pixi >= 0.74 is required to read lock-file format v7 (pixi.lock was
# regenerated when xgboost was added); pinned to match the local pixi.

# Header
Bootstrap: docker
From: ghcr.io/prefix-dev/pixi:0.80.0

# Files
%files
    pyproject.toml /opt/app/pyproject.toml
    pixi.lock /opt/app/pixi.lock

# Install dependencies
%post
    apt update
    apt install -y git

    cd /opt/app

    # Setup pixi dependencies
    pixi install --all

    # Clean up
    rm -rf ~/.cache/rattler
